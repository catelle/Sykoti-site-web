{
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/cyberambassador/regiistration",
      "destination": "/cyberambassador/registration/",
      "permanent": true
    },
    {
      "source": "/cyberambassador/regiistration/",
      "destination": "/cyberambassador/registration/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/cyberambassador",
      "destination": "/cyberambassador/index.html"
    },
    {
      "source": "/cyberambassador/",
      "destination": "/cyberambassador/index.html"
    },
    {
      "source": "/cyberambassador/registration",
      "destination": "/cyberambassador/registration/index.html"
    },
    {
      "source": "/cyberambassador/registration/",
      "destination": "/cyberambassador/registration/index.html"
    },
    {
      "source": "/scholarship",
      "destination": "/scholarship/index.html"
    },
    {
      "source": "/scholarship/",
      "destination": "/scholarship/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/programs",
      "destination": "/index.html"
    },
    {
      "source": "/cyberambassador-program",
      "destination": "/index.html"
    },
    {
      "source": "/impact",
      "destination": "/index.html"
    },
    {
      "source": "/resources",
      "destination": "/index.html"
    },
    {
      "source": "/partner",
      "destination": "/index.html"
    },
    {
      "source": "/engagement",
      "destination": "/index.html"
    },
    {
      "source": "/mur-des-engagements",
      "destination": "/index.html"
    }
  ]
}
